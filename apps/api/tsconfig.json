{
  "compilerOptions": {
    "rootDir": "../..",
    "paths": {
      "@shared/*": ["packages/shared/*"],
      "@web/*": ["apps/web/*"],
      "@api/*": ["apps/api/*"]
    },
    "outDir": "dist",
    "module": "commonjs",
    "target": "es6",
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
