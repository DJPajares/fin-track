{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --project tsconfig.json",
    "add-build": "git add dist",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "update-payments:userId": "ts-node scripts/upsertUserIdToPayments.ts",
    "update-transactions:userId": "ts-node scripts/upsertUserIdToTransactions.ts",
    "update-keys-in-collection": "ts-node scripts/updateKeysInCollection.ts",
    "update-values-in-collection": "ts-node scripts/updateValuesInCollection.ts",
    "seed-categories": "ts-node scripts/seedCategories.ts",
    "drop-category-indexes": "ts-node scripts/dropCategoryIndexes.ts",
    "test": "echo \"No tests in api\"",
    "clean": "rm -rf dist .turbo node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "pre-commit": [
    "type-check",
    "build",
    "add-build"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fin-track/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^9.3.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "nodemon": "^3.1.11",
    "tsc-alias": "^1.8.16",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
