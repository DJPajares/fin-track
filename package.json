{
  "name": "fin-track",
  "version": "3.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "lint:fix": "pnpm -r run lint:fix",
    "clean": "turbo clean && rm -rf node_modules",
    "test": "turbo test",
    "test:watch": "pnpm -r run test:watch",
    "test:coverage": "turbo test:coverage",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "deps:check": "pnpm -r outdated"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss}": [
      "prettier --write"
    ],
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "pnpm --filter web exec eslint --fix --max-warnings=0",
      "pnpm --filter web exec vitest related --run --passWithNoTests"
    ],
    "apps/api/src/**/*.ts": [
      "pnpm --filter api exec eslint --fix --max-warnings=0",
      "pnpm --filter api exec vitest related --run --passWithNoTests"
    ],
    "packages/shared/**/*.ts": [
      "pnpm --filter shared exec vitest related --run --passWithNoTests"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
