{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.json"],
  "exclude": ["node_modules"]
}
